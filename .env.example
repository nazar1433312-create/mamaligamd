APP_NAME=MamaligaMD
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_TIMEZONE=Europe/Chisinau
APP_LOCALE=ro

# Telegram chat id of the admin/owner who receives support ticket notifications
# (send /start to the bot, then check the `users` table or bot logs for your telegram_id)
ADMIN_TELEGRAM_CHAT_ID=

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Compose host port for the web container (nginx listens here on 127.0.0.1)
APP_PORT=8090

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mamaligamd
DB_USERNAME=mamaligamd
DB_PASSWORD=change_me

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change_me

# LiqPay
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

# Platform commission, percent withheld from executor payout
PLATFORM_COMMISSION_PERCENT=12

# Extra HTTP Basic Auth layer in front of /admin, on top of the normal is_admin check.
# Change these before going live!
ADMIN_GATE_USERNAME=admin
ADMIN_GATE_PASSWORD=admin

MAIL_MAILER=log
