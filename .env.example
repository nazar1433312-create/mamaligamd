APP_NAME=MamaligaMD
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_TIMEZONE=Europe/Chisinau
APP_LOCALE=ro

# Telegram chat id of the admin/owner who receives support ticket notifications
# (send /start to the bot, then check the `users` table or bot logs for your telegram_id)
ADMIN_TELEGRAM_CHAT_ID=

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Compose host port for the web container (nginx listens here on 127.0.0.1)
APP_PORT=8090

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mamaligamd
DB_USERNAME=mamaligamd
DB_PASSWORD=change_me

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change_me

# Victoriabank e-Commerce Gateway (Moldova).
# Obtain TERMINAL/MERCHANT ids and the three PEM key files from your Victoriabank
# manager after signing the merchant agreement. Put the key files in
# storage/app/victoriabank/ on the server (path set by VICTORIA_BANK_CERT_DIR)
# and reference them here by filename only.
VICTORIA_BANK_MERCHANT_ID=
VICTORIA_BANK_MERCHANT_TERMINAL=
VICTORIA_BANK_MERCHANT_URL=https://mamaligamd.duckdns.org
VICTORIA_BANK_MERCHANT_NAME=MamaligaMD
VICTORIA_BANK_MERCHANT_ADDRESS=
VICTORIA_BANK_MERCHANT_TIMEZONE_NAME=Europe/Chisinau
VICTORIA_BANK_MERCHANT_COUNTRY_CODE=MD
VICTORIA_BANK_MERCHANT_DEFAULT_CURRENCY=MDL
VICTORIA_BANK_MERCHANT_DEFAULT_LANGUAGE=ro
# Provided by the bank together with the certificates
VICTORIA_BANK_SECURITY_SIGNATURE_FIRST=
VICTORIA_BANK_SECURITY_SIGNATURE_PREFIX=
VICTORIA_BANK_SECURITY_SIGNATURE_PADDING=
# Filenames only (looked up inside VICTORIA_BANK_CERT_DIR)
VICTORIA_BANK_MERCHANT_PUBLIC_KEY=public.pem
VICTORIA_BANK_MERCHANT_PRIVATE_KEY=private.pem
VICTORIA_BANK_MERCHANT_BANK_PUBLIC_KEY=victoria_pub.pem
VICTORIA_BANK_CERT_DIR=/var/www/html/storage/app/victoriabank

# Fixed platform fee (MDL) charged to the customer when publishing an order
PLATFORM_FEE_AMOUNT=50

# Extra HTTP Basic Auth layer in front of /admin, on top of the normal is_admin check.
# Change these before going live!
ADMIN_GATE_USERNAME=admin
ADMIN_GATE_PASSWORD=admin

MAIL_MAILER=log
